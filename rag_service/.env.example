# 阿里云百炼 DashScope API Key（用于 Qwen 对话 / text-embedding 嵌入）
DASHSCOPE_API_KEY="sk-..."

# 默认服务商：dashscope | ollama（也可在系统设置中动态切换）
provider="dashscope"

# 对话模型
chat_model="qwen3.7-plus"

# 嵌入模型
embedding_model="text-embedding-v4"

# OpenAI 兼容 Base URL（Qwen 国内版：https://dashscope.aliyuncs.com/compatible-mode/v1）
api_url=""

# 采样温度
temperature=0.2
